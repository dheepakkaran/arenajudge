  "cuda_profiling": {
    "experiments": [
      {
        "id": "E0",
        "name": "Baseline timing",
        "finding": "GPU 99.8% busy, CPU prep 0.2%: compute-bound",
        "result": "16.0 samples/s"
      },
      {
        "id": "E1",
        "name": "torch.profiler kernel breakdown",
        "finding": "matmul 60.8%, element-wise 25.3%, attention 13.9% (8.2% on a slow fallback path)",
        "result": "found the attention fallback"
      },
      {
        "id": "E2",
        "name": "Pinned memory + CUDA stream",
        "finding": "CPU was never the bottleneck",
        "result": "0.83-0.93x (no gain)"
      },
      {
        "id": "E3",
        "name": "torch.compile",
        "finding": "fusion only touches the 25% element-wise part",
        "result": "0.94-1.04x (no reliable gain)"
      },
      {
        "id": "E4",
        "name": "CUDA Graphs, batch 1",
        "finding": "removes per-kernel launch overhead; matters most for short inputs",
        "result": "2.29x at 32 tokens, 1.27x at 512 tokens"
      },
      {
        "id": "E5",
        "name": "Attention fallback fix",
        "finding": "GQA + zero-padding batches skipped K/V head expansion; PyTorch fell back to unfused attention. Fix: pad batches to a multiple of 8",
        "result": "23-24% faster on affected batches, 7.6% overall"
      }
    ],
    "kernel_breakdown_pct": {
      "matmul": 60.8,
      "elementwise": 25.3,
      "attention_total": 13.9,
      "attention_fallback_part": 8.2
    },
    "cuda_graphs_speedup": [
      {
        "tokens": 32,
        "speedup": 2.29
      },
      {
        "tokens": 512,
        "speedup": 1.27
      }
